# Supabase (Database + Auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role (Settings → API) — signup auto-confirms email so login works immediately
# Keep secret. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google OAuth (configured mainly in Supabase Dashboard → Auth → Providers → Google)
# Create credentials in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI must include:
#   https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Auth emails — Supabase Dashboard SMTP (confirm / magic link)
# Sender name: HRMS
# Sender email: zakria.haq123@gmail.com
# See SETUP-EMAIL.md

# App mailer (Google login + every login/signup notice from HRMS)
# Same Gmail App Password you use in Supabase Custom SMTP
SMTP_USER=zakria.haq123@gmail.com
SMTP_PASS=your_gmail_16_char_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
